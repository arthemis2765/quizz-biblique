# Copie ce fichier en .env (ou configure ces variables directement sur ta
# plateforme d'hébergement — Render, Railway, Fly.io, etc.)

# URL de connexion PostgreSQL fournie par ton hébergeur.
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bible_quiz

# Port d'écoute du serveur (souvent injecté automatiquement par l'hébergeur)
PORT=5000
